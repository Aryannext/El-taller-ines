<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_propuesto_2_aviso_y_seguimiento" targetNamespace="https://github.com/Aryannext/puntada" exporter="scripts/generar_procesos.py" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion">
    <bpmn:participant id="Participante" name="Taller de costura · con Puntada · Aviso y seguimiento" processRef="Proceso" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso" name="Aviso y seguimiento" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_cliente" name="Cliente del taller">
        <bpmn:flowNodeRef>recibe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>viene</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>une</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_duena" name="Dueña del taller">
        <bpmn:flowNodeRef>asistido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vuelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sin_reclamar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_sistema" name="Puntada">
        <bpmn:flowNodeRef>lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>une_aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>panel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="lista" name="La orden queda lista para entregar">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="aviso" name="Enviar el aviso automático por WhatsApp&#10;HU-28 · RN-37 · RN-40">
      <bpmn:documentation>HU-28 · RN-37 · RN-40</bpmn:documentation>
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="acepto" name="¿WhatsApp aceptó el mensaje?">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="asistido" name="Enviar el aviso asistido con un toque&#10;HU-29">
      <bpmn:documentation>HU-29</bpmn:documentation>
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="une_aviso">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="recibe" name="Recibe el aviso">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definicion_recibe" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="viene" name="¿Viene en la fecha acordada?">
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="panel" name="Mostrar la orden en el panel con sus días de espera&#10;HU-32 · HU-34 · RN-35 · RN-36">
      <bpmn:documentation>HU-32 · HU-34 · RN-35 · RN-36</bpmn:documentation>
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="escribe" name="Escribirle por WhatsApp para acordar otro día">
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="vuelve" name="¿El cliente viene?">
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="decide" name="Decidir qué hacer con las prendas, fuera del sistema">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="sin_reclamar" name="Orden sin reclamar, contada en el panel">
      <bpmn:incoming>Flujo_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="une">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fin" name="Sigue en entrega y cobro">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="lista" targetRef="aviso" />
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="aviso" targetRef="acepto" />
    <bpmn:sequenceFlow id="Flujo_2" name="Sí" sourceRef="acepto" targetRef="une_aviso" />
    <bpmn:sequenceFlow id="Flujo_3" name="No" sourceRef="acepto" targetRef="asistido" />
    <bpmn:sequenceFlow id="Flujo_4" sourceRef="asistido" targetRef="une_aviso" />
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="une_aviso" targetRef="recibe" />
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="recibe" targetRef="viene" />
    <bpmn:sequenceFlow id="Flujo_7" name="Sí" sourceRef="viene" targetRef="une" />
    <bpmn:sequenceFlow id="Flujo_8" name="No" sourceRef="viene" targetRef="panel" />
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="panel" targetRef="escribe" />
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="escribe" targetRef="vuelve" />
    <bpmn:sequenceFlow id="Flujo_11" name="Sí" sourceRef="vuelve" targetRef="une" />
    <bpmn:sequenceFlow id="Flujo_12" name="No" sourceRef="vuelve" targetRef="decide" />
    <bpmn:sequenceFlow id="Flujo_13" sourceRef="decide" targetRef="sin_reclamar" />
    <bpmn:sequenceFlow id="Flujo_14" sourceRef="une" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Colaboracion">
      <bpmndi:BPMNShape id="Participante_di" bpmnElement="Participante" isHorizontal="true">
        <dc:Bounds x="10" y="10" width="1980" height="552" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_cliente_di" bpmnElement="Carril_cliente" isHorizontal="true">
        <dc:Bounds x="40" y="10" width="1950" height="184" />
