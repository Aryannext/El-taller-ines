          <dc:Bounds x="957" y="317" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8">
        <di:waypoint x="1175" y="286" />
        <di:waypoint x="1245" y="286" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9">
