        <di:waypoint x="925" y="286" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="663" y="84" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6">
        <di:waypoint x="975" y="286" />
        <di:waypoint x="1045" y="286" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="983" y="268" width="22" height="14" />
