<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_propuesto_3_entrega_y_cobro" targetNamespace="https://github.com/Aryannext/El-taller-ines" exporter="scripts/generar_procesos.py" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion">
    <bpmn:participant id="Participante" name="Taller de costura · con El-taller-ines · Entrega y cobro" processRef="Proceso" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso" name="Entrega y cobro" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_cliente" name="Cliente del taller">
        <bpmn:flowNodeRef>llega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>falta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_duena" name="Dueña del taller">
        <bpmn:flowNodeRef>busca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>terminadas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rapido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>otro_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sin_prenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>une</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retoque</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>paga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>une_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>entrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_sistema" name="El-taller-ines">
        <bpmn:flowNodeRef>registra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="llega" name="Llega a recoger sus prendas">
      <bpmn:outgoing>Flujo_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="busca" name="Buscar la orden y reconocer las prendas por sus fotos&#10;HU-15 · HU-18">
      <bpmn:documentation>HU-15 · HU-18</bpmn:documentation>
      <bpmn:incoming>Flujo_0</bpmn:incoming>
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="terminadas" name="¿Están terminadas?">
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="rapido" name="¿El arreglo es rápido?">
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="espera" name="Terminarlo mientras el cliente espera y marcarlo Terminada&#10;HU-20">
      <bpmn:documentation>HU-20</bpmn:documentation>
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="otro_dia" name="Acordar otro día o devolver la prenda sin arreglar&#10;HU-36 · RN-44">
      <bpmn:documentation>HU-36 · RN-44</bpmn:documentation>
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="sin_prenda" name="Vuelve otro día o se lleva la prenda sin arreglar">
      <bpmn:incoming>Flujo_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="une">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="mide" name="Medirse las prendas">
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="falta" name="¿Le falta algo al arreglo?">
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="retoque" name="Devolver la prenda a En proceso y terminar el retoque&#10;HU-20 · RN-14">
      <bpmn:documentation>HU-20 · RN-14</bpmn:documentation>
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="paga" name="¿Paga algo ahora?">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_13</bpmn:outgoing>
      <bpmn:outgoing>Flujo_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pago" name="Registrar el pago&#10;HU-23 · RN-28">
      <bpmn:documentation>HU-23 · RN-28</bpmn:documentation>
      <bpmn:incoming>Flujo_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="une_pago">
      <bpmn:incoming>Flujo_14</bpmn:incoming>
      <bpmn:incoming>Flujo_15</bpmn:incoming>
      <bpmn:outgoing>Flujo_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="entrega" name="Entregar la orden y confirmar si queda saldo&#10;HU-21 · RN-20 · RN-21">
      <bpmn:documentation>HU-21 · RN-20 · RN-21</bpmn:documentation>
      <bpmn:incoming>Flujo_16</bpmn:incoming>
      <bpmn:outgoing>Flujo_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="registra" name="Registrar la entrega y dejar el saldo por cobrar&#10;RN-23 · RN-27 · RN-32">
      <bpmn:documentation>RN-23 · RN-27 · RN-32</bpmn:documentation>
      <bpmn:incoming>Flujo_17</bpmn:incoming>
      <bpmn:outgoing>Flujo_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fin" name="Orden entregada">
      <bpmn:incoming>Flujo_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_0" sourceRef="llega" targetRef="busca" />
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="busca" targetRef="terminadas" />
    <bpmn:sequenceFlow id="Flujo_2" name="Sí" sourceRef="terminadas" targetRef="une" />
    <bpmn:sequenceFlow id="Flujo_3" name="No" sourceRef="terminadas" targetRef="rapido" />
    <bpmn:sequenceFlow id="Flujo_4" name="Sí" sourceRef="rapido" targetRef="espera" />
    <bpmn:sequenceFlow id="Flujo_5" name="No" sourceRef="rapido" targetRef="otro_dia" />
    <bpmn:sequenceFlow id="Flujo_6" sourceRef="espera" targetRef="une" />
    <bpmn:sequenceFlow id="Flujo_7" sourceRef="otro_dia" targetRef="sin_prenda" />
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="une" targetRef="mide" />
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="mide" targetRef="falta" />
    <bpmn:sequenceFlow id="Flujo_10" name="Sí" sourceRef="falta" targetRef="retoque" />
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="retoque" targetRef="mide" />
    <bpmn:sequenceFlow id="Flujo_12" name="No" sourceRef="falta" targetRef="paga" />
    <bpmn:sequenceFlow id="Flujo_13" name="Sí" sourceRef="paga" targetRef="pago" />
    <bpmn:sequenceFlow id="Flujo_14" name="No" sourceRef="paga" targetRef="une_pago" />
    <bpmn:sequenceFlow id="Flujo_15" sourceRef="pago" targetRef="une_pago" />
    <bpmn:sequenceFlow id="Flujo_16" sourceRef="une_pago" targetRef="entrega" />
    <bpmn:sequenceFlow id="Flujo_17" sourceRef="entrega" targetRef="registra" />
    <bpmn:sequenceFlow id="Flujo_18" sourceRef="registra" targetRef="fin" />
  </bpmn:process>
