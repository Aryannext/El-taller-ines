# Variables de producción de Puntada en el VPS. instalar.sh copia este archivo a despliegue/.env y genera los secretos.
# Qué hace cada una: docs/04-especificacion-tecnica/07-despliegue-y-operacion.md. despliegue/.env no se versiona (RNF-24).

APP_NAME=Puntada
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://proyectosena.online/taller
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=taller
DB_USERNAME=taller
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/taller

CACHE_STORE=file
QUEUE_CONNECTION=database

# Vacías: los avisos quedan para envío asistido hasta terminar HT-01 (ADR-003)
WHATSAPP_TOKEN=
WHATSAPP_ID_NUMERO=
WHATSAPP_VERSION_API=
WHATSAPP_PLANTILLA=orden_lista
WHATSAPP_IDIOMA=es

# ADR-007: Evolution API, en este mismo docker-compose. completar-env.sh genera la clave y la contraseña.
# EVOLUTION_INSTANCIA se llena cuando el WhatsApp ya está conectado: mientras esté vacía, los avisos van al envío asistido
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
EVOLUTION_DB_PASSWORD=

# La contraseña no va aquí: crear-usuaria.sh la pide sin mostrarla
USUARIA_INICIAL_USUARIO=taller

# Respaldos (RNF-15). Los corre el cron del host: despliegue/cron/taller
RESPALDO_CARPETA=/var/respaldos/taller
RESPALDO_DIAS=14
RESPALDO_REMOTO=drive:taller-respaldos
RESPALDO_COPIAS_REMOTAS=2
