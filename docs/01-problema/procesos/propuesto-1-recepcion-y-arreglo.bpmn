        <di:waypoint x="1110" y="341" />
        <di:waypoint x="1110" y="311" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="797" y="317" width="22" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6">
        <di:waypoint x="1015" y="286" />
        <di:waypoint x="1085" y="286" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7">
        <di:waypoint x="1135" y="286" />
        <di:waypoint x="1170" y="286" />
        <di:waypoint x="1170" y="470" />
        <di:waypoint x="1205" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8">
        <di:waypoint x="1335" y="470" />
        <di:waypoint x="1350" y="470" />
        <di:waypoint x="1350" y="286" />
        <di:waypoint x="1365" y="286" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9">
        <di:waypoint x="1495" y="286" />
