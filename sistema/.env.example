# Variables de entorno de Puntada.
# Qué hace cada una y su valor en producción: docs/04-especificacion-tecnica/07-despliegue-y-operacion.md

APP_NAME=Puntada
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taller
DB_USERNAME=taller
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Vacías: los avisos quedan para envío asistido (ADR-003)
WHATSAPP_TOKEN=
WHATSAPP_ID_NUMERO=
WHATSAPP_VERSION_API=
WHATSAPP_PLANTILLA=orden_lista
WHATSAPP_IDIOMA=es

# ADR-007: aviso automático por Evolution API. Si están vacías, se usa la API oficial o el envío asistido
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=

# Solo para NegocioInicialSeeder; borrar la contraseña después de instalar
USUARIA_INICIAL_USUARIO=taller
USUARIA_INICIAL_CONTRASENA=

# Solo en el VPS
RESPALDO_CARPETA=
RESPALDO_DIAS=14
RESPALDO_REMOTO=
RESPALDO_COPIAS_REMOTAS=2
