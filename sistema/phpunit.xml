<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- RNF-28 mide la cobertura de la lógica de negocio, no de todo app/ -->
    <source>
        <include>
            <directory>app/Dominio</directory>
            <directory>app/Aplicacion</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- MySQL y no SQLite: la intercalación, la llave compuesta y los bloqueos se comportan distinto (plan de pruebas) -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="taller_pruebas"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Como en el VPS: con «sync» el envío correría dentro de la solicitud (RNF-04) -->
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="WHATSAPP_TOKEN" value=""/>
        <env name="WHATSAPP_ID_NUMERO" value=""/>
    </php>
</phpunit>
