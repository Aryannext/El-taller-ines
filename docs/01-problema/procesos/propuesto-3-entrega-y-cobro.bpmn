      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_10_di" bpmnElement="Flujo_10">
        <di:waypoint x="1495" y="286" />
        <di:waypoint x="1510" y="286" />
        <di:waypoint x="1510" y="470" />
        <di:waypoint x="1525" y="470" />
