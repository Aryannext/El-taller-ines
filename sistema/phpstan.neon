includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    # RNF-29: nivel 5 o superior, sin errores
    level: 5
    # Lee las conversiones del método casts() de cada modelo, como EstadoDePrenda o immutable_datetime.
    # Sin esto, Larastan solo ve que casts() devuelve un array y usa los tipos de las migraciones.
    parseModelCastsMethod: true
    paths:
        - app
        - database
        - routes

services:
    # RNF-27: las reglas de dependencias entre capas (ADR-005)
    -
        class: Tests\Arquitectura\ReglasDeCapas
        tags:
            - phpat.test
