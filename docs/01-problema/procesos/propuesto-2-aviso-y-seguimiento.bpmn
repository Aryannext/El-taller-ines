      <bpmndi:BPMNShape id="une_aviso_di" bpmnElement="une_aviso" isMarkerVisible="true">
        <dc:Bounds x="765" y="445" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recibe_di" bpmnElement="recibe">
        <dc:Bounds x="932" y="84" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="viene_di" bpmnElement="viene" isMarkerVisible="true">
        <dc:Bounds x="1085" y="77" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="panel_di" bpmnElement="panel">
        <dc:Bounds x="1205" y="422" width="130" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escribe_di" bpmnElement="escribe">
        <dc:Bounds x="1365" y="238" width="130" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vuelve_di" bpmnElement="vuelve" isMarkerVisible="true">
        <dc:Bounds x="1565" y="261" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide">
        <dc:Bounds x="1685" y="238" width="130" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sin_reclamar_di" bpmnElement="sin_reclamar">
        <dc:Bounds x="1892" y="268" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="une_di" bpmnElement="une" isMarkerVisible="true">
        <dc:Bounds x="1725" y="77" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="1892" y="84" width="36" height="36" />
      </bpmndi:BPMNShape>
